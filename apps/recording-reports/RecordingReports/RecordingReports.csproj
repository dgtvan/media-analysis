<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RecordingReports</AssemblyName>
    <RootNamespace>RecordingReports</RootNamespace>
    <AssemblyTitle>Recording Reports</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Keep the idle footprint small: no background GC thread, no culture data. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="RecordingReports.App" />
    <Using Include="RecordingReports.Analysis" />
    <Using Include="RecordingReports.Projects" />
    <Using Include="RecordingReports.Templates" />
    <Using Include="RecordingReports.UI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecordingReports.Tests" />
  </ItemGroup>

</Project>
